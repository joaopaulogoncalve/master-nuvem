{
  "name": "master-nuvem",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "master-nuvem-db",
      "database_id": "b60c217f-b668-4f05-a94a-ba8a8620f085"
    }
  ],
  "routes": [
    { "pattern": "masternuvem.com.br", "custom_domain": true },
    { "pattern": "www.masternuvem.com.br", "custom_domain": true }
  ],
  // "0 * * * *" = limpeza de hora em hora; "*/20 * * * *" = sentinela (vigia de segurança a cada 20 minutos).
  "triggers": { "crons": ["0 * * * *", "*/20 * * * *"] },
  // Ligação interna com o Worker do China em Casa (ponte do Lucro Online). Worker não pode chamar outro da mesma conta pelo *.workers.dev.
  "services": [{ "binding": "CHINA_EM_CASA", "service": "china-em-casa" }],
  "observability": { "enabled": true }
}
